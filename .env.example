# Required
DATABASE_URL=postgresql://user:password@host:5432/openfront_electronics_recycling
# At least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Optional: card payments on invoices (bank transfer works without these)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: outgoing email (can also be set on the Store settings page)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: the assistant panel in the dashboard
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
